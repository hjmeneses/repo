{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#0077c2",
          "foreground": "#ffffff",
          "leading_diamond": "╭─",
          "style": "diamond",
          "template": " {{ .Name }} ",
          "type": "shell"
        },
        {
          "background": "#004c8c",
          "foreground": "#aecbfa",
          "powerline_symbol": "",
          "options": {
            "display_default": false
          },
          "style": "powerline",
          "template": "  {{ .UserName }}{{ if .SSHSession }}@{{ .HostName }}{{ end }} ",
          "type": "session"
        },
        {
          "background": "#ef5350",
          "foreground": "#FFFB38",
          "style": "diamond",
          "template": "<parentBackground></>  ",
          "type": "root"
        },
        {
          "background": "#FF9248",
          "foreground": "#2d3436",
          "powerline_symbol": "",
          "options": {
            "folder_icon": "  ",
            "home_icon": "",
            "mapped_locations_enabled": true,
            "mapped_locations": {
              "~": "",
              "~/Desktop": " Desktop",
              "~/Documents": "󰈙 Docs",
              "~/Downloads": "󰇚 Downloads",
              "~/Pictures": " Pictures",
              "~/.config/ohmyposh": " OMP",
              "C:/AWS-Reports": "󰸏 AWS Reports",
              "~/Music": " Music",
              "~/Videos": " Videos",
              "~/.config": " Config",
              "~/GitHub": " Github",
              "~/Projects": "󰲋 Projects",
              "~/Tools": " Tools"
            },
            "max_depth": 4,
            "style": "folder"
          },
          "style": "powerline",
          "template": "   {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#FFFB38",
          "foreground": "#011627",
          "powerline_symbol": "",
          "options": {
            "branch_icon": " ",
            "fetch_status": false
          },
          "style": "powerline",
          "template": " {{ .HEAD }} ",
          "type": "git"
        },
        {
          "background": "#83769c",
          "foreground": "#ffffff",
          "options": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",
          "template": "  {{ .FormattedMs }} ",
          "trailing_diamond": "",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#303030",
          "foreground": "#3C873A",
          "leading_diamond": "",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": " <#cc3a3a></> ",
            "yarn_icon": " <#348cba></>",
            "display_mode": "context"
          },
          "style": "diamond",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "trailing_diamond": " ",
          "type": "node"
        },
        {
          "background": "#306998",
          "foreground": "#FFE873",
          "leading_diamond": "",
          "options": {
            "display_mode": "context"
          },
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "python"
        },
        {
          "background": "#565656",
          "foreground": "#faa029",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "trailing_diamond": " ",
          "type": "aws"
        },
        {
          "background": "#b2bec3",
          "foreground": "#222222",
          "leading_diamond": "",
          "trailing_diamond": "<transparent,background></>",
          "options": {
            "linux": "",
            "macos": "",
            "windows": ""
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "background": "#f36943",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#b8e994{{end}}",
            "{{if eq \"Discharging\" .State.String}}#fff34e{{end}}",
            "{{if eq \"Full\" .State.String}}#33DD2D{{end}}"
          ],
          "foreground": "#262626",
          "invert_powerline": true,
          "powerline_symbol": "",
          "options": {
            "charged_icon": " ",
            "charging_icon": " ",
            "discharging_icon": " "
          },
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }} ",
          "type": "battery"
        },
        {
          "background": "#40c4ff",
          "foreground": "#ffffff",
          "invert_powerline": true,
          "leading_diamond": "",
          "options": {
            "time_format": "02 Jan · 15:04:05"
          },
          "style": "diamond",
          "template": "  {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#21c7c7",
          "style": "plain",
          "template": "╰─",
          "type": "text"
        },
        {
          "foreground": "#e0f8ff",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef5350{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}